# Optional: enables natural-language inspector briefings.
# The product works fully without any of these — it falls back to a
# deterministic template. Copy this file to `.env` and fill in a key to
# switch on the LLM path. Anthropic is tried first, then OpenAI.
#
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
#
# Force a specific briefing mode (auto | template | anthropic | openai).
# Defaults to "auto" (use a key if present, otherwise template).
# RISK_RADAR_LLM=auto
